{
  "name": "first-chance",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:up": "docker compose up -d",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/database/seed.ts",
    "setup": "npm run db:up && sleep 3 && npm run db:push && npm run db:seed",
    "db:reset": "docker exec first-chance-db psql -U firstchance -d first_chance -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:push && npm run db:seed",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/simple-icons": "^1.2.97",
    "@nuxt/ui": "^4.11.2",
    "@solana/web3.js": "^1.99.0",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
